<?xml version="1.0" encoding="utf-8"?>
<Project>
    <PropertyGroup>
        <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Sons Of The Forest</GameDir>
        <!-- Local copy of RedLoader 0.8.6 net6 libs, so builds work even when Vortex has RedLoader undeployed -->
        <RedLoaderLibDir>$(MSBuildThisFileDirectory)sdk-ref</RedLoaderLibDir>
    </PropertyGroup>
</Project>
